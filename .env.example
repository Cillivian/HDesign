# HDesign AI proxy (DeepSeek OpenAI-compatible)
PORT=8791
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_REASONING_MODEL=deepseek-v4-pro
AI_THINKING=off
AI_TIMEOUT_MS=90000
AI_MAX_IMAGES=6
AI_MOCK=0
ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MIN=20

# Host port when using docker-compose on a NAS (app still listens on 8791 inside)
HDESIGN_PORT=8791
